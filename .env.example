# rag_qa_project 环境变量模板
#
# 用法：复制到**仓库根的上一级**并改名为 .env（即 my_langchain_demo/.env）：
#
#     cp .env.example ../.env      # 从 advanced_tutorial/ 下执行
#
# 为什么在仓库外：advanced_tutorial/ 是 git 仓库根，而 config.py 读的是
# PROJECT_DIR.parent.parent/.env，即 rag_qa_project/../../.env —— 天然不在版本库内。
# .gitignore 里另有 .env / .env.* / !.env.example 作双保险。
#
# ⚠ 本文件里所有值都是占位符，不要直接用。
# ⚠ 只有 RAGQA_ 开头的是本项目自己的配置（config.py 的 env_prefix="RAGQA_"），
#    其余是第三方 SDK 直接读的环境变量（ChatDeepSeek / DashScopeEmbeddings / Tavily / LangSmith）。

# ==================== P2 账号体系（新增，前两项必填）====================

# ---- JWT：缺了后端起不来 ----
# config.py 的 @model_validator 要求：非空，且 UTF-8 ≥ 32 字节，否则抛 ValidationError。
# 生成：openssl rand -hex 32    （得到 64 个十六进制字符）
# 为什么必须够长：HS256 的 HMAC 密钥不足 32 字节时，PyJWT 每次编解码都会警告
# （RFC 7518 §3.2）。留空更是等于把 token 签发权交给任何人。
RAGQA_JWT_SECRET=

# ---- MySQL：users / conversations 两张表所在库 ----
# 库必须已存在，且字符集 / 排序规则为 utf8mb4 / utf8mb4_0900_ai_ci。
# 后者大小写不敏感，是「Alice 与 alice 撞唯一键」这条契约的保证，不是应用层比对。
#   CREATE DATABASE rag_qa CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
# ⚠ 口令含 @ : / # 等保留字符时必须 URL 编码（@ 写成 %40），或改用 sqlalchemy.URL.create
RAGQA_MYSQL_DATABASE_URL=mysql+aiomysql://root:<你的密码>@localhost:3306/rag_qa?charset=utf8mb4

# 打印全部 SQL。默认 false：本项目是 SSE 流式问答，每个请求都跑 LLM + 检索，
# 全量 SQL 日志会淹没应用日志并拖慢吞吐。只在排查 SQL 问题时临时打开。
RAGQA_SQL_ECHO=false

# ---- 其余可调项（都有默认值，一般不用写）----
# RAGQA_JWT_ALGORITHM=HS256
# RAGQA_JWT_EXPIRE_DAYS=7
# RAGQA_TOP_K=4
# RAGQA_CHUNK_SIZE=1000
# RAGQA_CHUNK_OVERLAP=150
# RAGQA_MAX_REWRITES=2
# RAGQA_GRADE_STRICT=true
# RAGQA_GRADE_PREVIEW_CHARS=400
# RAGQA_TEMPERATURE=0.1
# RAGQA_DEEPSEEK_MODEL=deepseek-chat
# RAGQA_EMBED_MODEL=qwen3.7-text-embedding
# RAGQA_RERANK_MODEL=qwen3.7-text-rerank

# ==================== P0 / P1 既有（缺了问答跑不起来）====================

# ---- LLM ----
DEEPSEEK_API_KEY=
# 只有走代理或兼容端点时才需要改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 嵌入与重排（DashScope）----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ---- 联网搜索工具（Agent 的 web_search）----
TAVILY_API_KEY=

# ---- HuggingFace 镜像 ----
# config.py 会 setdefault 成 hf-mirror.com；国内环境保留即可
HF_ENDPOINT=https://hf-mirror.com

# ==================== 可选：链路追踪与文档解析增强 ====================

# ---- LangSmith：可视化每次 ReAct 循环的中间步骤，调 Agent 很省事 ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT_NAME=rag-qa-project
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- 阿里云 OSS / MinerU：仅 ingest 大文件或 PDF 深解析时才用得到 ----
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_BUCKET_NAME=
ALI_OSS_ENDPOINT=
MINERU_TOKEN=
